# Gemini API Key (for server-side document OCR and intelligence)
GEMINI_API_KEY=

# Firebase Cloud Messaging (FCM) Web Push Configuration
# Public Web Push certificate key pair (Firebase Console -> Project Settings -> Cloud Messaging -> Web Push certificates)
VITE_FIREBASE_VAPID_KEY=
# Server-side FCM HTTP v1 Service Account JSON string (for dispatching background OS push notifications via /api/push/send)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional Legacy FCM Server Key fallback
FCM_SERVER_KEY=

# Cloud SQL / PostgreSQL (Optional, defaults to mock if not configured)
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=
