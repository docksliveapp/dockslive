# Gemini API Key (for server-side document OCR and intelligence)
GEMINI_API_KEY=

# Firebase Cloud Messaging (FCM) & Web Push VAPID Configuration
VITE_FIREBASE_VAPID_KEY=
VAPID_SUBJECT=mailto:arbab@mak-group.com.pk
# Server-side VAPID Private Key (set in hosting/server secrets only — never commit private key to git)
VAPID_PRIVATE_KEY=
# Optional Server-side FCM HTTP v1 Service Account JSON string
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional Legacy FCM Server Key fallback
FCM_SERVER_KEY=

# Cloud SQL / PostgreSQL (Optional, defaults to mock if not configured)
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=
