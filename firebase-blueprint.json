    "CompanyDocument": {
      "title": "CompanyDocument",
      "description": "Explorer document file (PDF or image) stored at root or inside nested folders with 7 core document metadata attributes and automated expiry/hearing alarms",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique document identifier", "maxLength": 160 },
        "title": { "type": "string", "description": "Document title", "maxLength": 240 },
        "isExplorerDocument": { "type": "boolean", "description": "Marks document as part of the Windows Explorer hierarchy" },
        "parentFolderId": { "type": "string", "description": "Parent folder ID, or empty/null when placed at Root", "maxLength": 160 },
        "folderPath": { "type": "string", "description": "Human-readable breadcrumb path of parent folders", "maxLength": 500 },
        "createdByAuthor": { "type": "string", "description": "Person, officer, or entity who created/prepared the document", "maxLength": 200 },
        "sourceOrigin": { "type": "string", "description": "Authority, office, or party from where the document originated", "maxLength": 200 },
        "creationDate": { "type": "string", "description": "Date when the document was created (YYYY-MM-DD)", "maxLength": 30 },
        "hasExpiryDate": { "type": "boolean", "description": "Whether the document has an expiration/validity end date" },
        "expiryDate": { "type": "string", "description": "Document expiration date (YYYY-MM-DD)", "maxLength": 30 },
        "hasHearingDate": { "type": "boolean", "description": "Whether the document has a scheduled hearing date" },
        "hearingDate": { "type": "string", "description": "Scheduled hearing date (YYYY-MM-DD)", "maxLength": 30 },
        "issuedTo": { "type": "string", "description": "Person(s) or entity to whom the document was issued or in whose name it stands", "maxLength": 240 },
        "category": { "type": "string", "description": "Folder classification label", "maxLength": 200 },
        "senderIssuer": { "type": "string", "description": "Source or issuing authority", "maxLength": 200 },
        "recipientEntity": { "type": "string", "description": "Issued-to person or entity", "maxLength": 240 },
        "issuanceDate": { "type": "string", "description": "Document creation/issuance date (YYYY-MM-DD)", "maxLength": 30 },
        "validityEndDate": { "type": "string", "description": "Expiry or validity end date (YYYY-MM-DD)", "maxLength": 30 },
        "alarmDaysBefore": { "type": "number", "description": "Lead days before expiry/hearing to trigger alarm" },
        "fileUrl": { "type": "string", "description": "URL or chunk storage link", "maxLength": 150000 },
        "uploadedAt": { "type": "string", "description": "Upload timestamp", "maxLength": 50 }
      },
      "required": ["title"]
    },
    "CompanyDocumentFolder": {
      "title": "CompanyDocumentFolder",
      "description": "Recursive Windows Explorer-style folder in Company Documents supporting unlimited nested sub-folders",
      "type": "object",
      "properties": {
