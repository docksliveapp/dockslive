        "updatedAt": { "type": "string", "description": "ISO timestamp when folder was updated", "maxLength": 50 },
        "createdBy": { "type": "string", "description": "User who created the folder", "maxLength": 150 }
      },
      "required": ["id", "title", "createdAt"]
    },
