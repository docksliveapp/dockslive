{
  "entities": {
    "Case": {
      "title": "Case",
      "description": "Logistics cargo and customs clearing case record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the case" },
        "caseNo": { "type": "string", "description": "System-generated case number e.g. DPL-26-000001", "maxLength": 64 },
        "clientName": { "type": "string", "description": "Name of the client importing or exporting goods", "maxLength": 150 },
        "category": { "type": "string", "description": "Logistics category such as Afghan Transit or Bonded Carrier", "maxLength": 100 },
        "status": { "type": "string", "description": "Current processing stage of the case", "maxLength": 80 },
        "pol": { "type": "string", "description": "Port of Loading code or name", "maxLength": 100 },
        "pod": { "type": "string", "description": "Port of Discharge code or name", "maxLength": 100 },
        "createdAt": { "type": "string", "description": "ISO date string when the case was created", "maxLength": 50 },
        "createdBy": { "type": "string", "description": "UID of the user who logged the case", "maxLength": 128 }
      },
      "required": ["caseNo", "clientName", "category", "status", "createdAt"]
    },
    "FinanceEntry": {
      "title": "FinanceEntry",
      "description": "Financial ledger entry, income, expense, receivable, or payable",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique finance entry ID" },
        "date": { "type": "string", "description": "Date of the transaction", "maxLength": 50 },
        "description": { "type": "string", "description": "Details or notes regarding the transaction", "maxLength": 250 },
        "amount": { "type": "number", "description": "Transaction amount in PKR" },
        "type": { "type": "string", "description": "Transaction category type (INCOME, EXPENSE, RECEIVABLE, PAYABLE)", "enum": ["INCOME", "EXPENSE", "RECEIVABLE", "PAYABLE"] },
        "status": { "type": "string", "description": "Status of payment (PAID, PENDING, PARTIAL)", "enum": ["PAID", "PENDING", "PARTIAL"] },
        "party": { "type": "string", "description": "Client or Vendor involved in transaction", "maxLength": 150 },
        "category": { "type": "string", "description": "Expense or revenue head", "maxLength": 100 },
        "reference": { "type": "string", "description": "Invoice or cheque reference", "maxLength": 100 },
        "paymentMethod": { "type": "string", "description": "Payment instrument method (CASH or BANK)", "maxLength": 20 },
        "bankName": { "type": "string", "description": "Associated bank name", "maxLength": 100 },
        "transactionId": { "type": "string", "description": "Bank transaction voucher ID", "maxLength": 100 },
        "createdBy": { "type": "string", "description": "UID of user who created the finance entry", "maxLength": 128 }
      },
      "required": ["date", "description", "amount", "type", "status", "party"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "Fleet or contract trailer and transport vehicle profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique vehicle ID" },
        "dplSerial": { "type": "string", "description": "DPL Fleet serial tracking number", "maxLength": 50 },
        "registrationNumber": { "type": "string", "description": "Official vehicle license plate number", "maxLength": 50 },
        "category": { "type": "string", "description": "Vehicle carrier regulatory classification", "maxLength": 80 },
        "type": { "type": "string", "description": "Trailer type such as Flatbed or Container carrier", "maxLength": 80 },
        "driverName": { "type": "string", "description": "Assigned driver's full name", "maxLength": 120 },
        "driverCnic": { "type": "string", "description": "Assigned driver's national identity card number", "maxLength": 30 },
        "driverContact": { "type": "string", "description": "Assigned driver's mobile phone number", "maxLength": 40 },
