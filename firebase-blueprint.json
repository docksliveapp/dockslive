{
  "entities": {
    "Case": {
      "title": "Case",
      "description": "Logistics cargo and customs clearing case record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the case" },
        "caseNo": { "type": "string", "description": "System-generated case number e.g. DPL-26-000001", "maxLength": 64 },
        "clientName": { "type": "string", "description": "Name of the client importing or exporting goods", "maxLength": 150 },
        "category": { "type": "string", "description": "Logistics category such as Afghan Transit or Bonded Carrier", "maxLength": 100 },
        "status": { "type": "string", "description": "Current processing stage of the case", "maxLength": 80 },
        "pol": { "type": "string", "description": "Port of Loading code or name", "maxLength": 100 },
        "pod": { "type": "string", "description": "Port of Discharge code or name", "maxLength": 100 },
        "createdAt": { "type": "string", "description": "ISO date string when the case was created", "maxLength": 50 },
        "createdBy": { "type": "string", "description": "UID of the user who logged the case", "maxLength": 128 }
      },
      "required": ["caseNo", "clientName", "category", "status", "createdAt"]
    },
    "FinanceEntry": {
      "title": "FinanceEntry",
      "description": "Financial ledger entry, income, expense, receivable, or payable",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique finance entry ID" },
        "date": { "type": "string", "description": "Date of the transaction", "maxLength": 50 },
        "description": { "type": "string", "description": "Details or notes regarding the transaction", "maxLength": 250 },
        "amount": { "type": "number", "description": "Transaction amount in PKR" },
        "type": { "type": "string", "description": "Transaction category type (INCOME, EXPENSE, RECEIVABLE, PAYABLE)", "enum": ["INCOME", "EXPENSE", "RECEIVABLE", "PAYABLE"] },
        "status": { "type": "string", "description": "Status of payment (PAID, PENDING, PARTIAL)", "enum": ["PAID", "PENDING", "PARTIAL"] },
        "party": { "type": "string", "description": "Client or Vendor involved in transaction", "maxLength": 150 },
        "category": { "type": "string", "description": "Expense or revenue head", "maxLength": 100 },
        "reference": { "type": "string", "description": "Invoice or cheque reference", "maxLength": 100 },
        "paymentMethod": { "type": "string", "description": "Payment instrument method (CASH or BANK)", "maxLength": 20 },
        "bankName": { "type": "string", "description": "Associated bank name", "maxLength": 100 },
        "transactionId": { "type": "string", "description": "Bank transaction voucher ID", "maxLength": 100 },
        "createdBy": { "type": "string", "description": "UID of user who created the finance entry", "maxLength": 128 }
      },
      "required": ["date", "description", "amount", "type", "status", "party"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "Fleet or contract trailer and transport vehicle profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique vehicle ID" },
        "dplSerial": { "type": "string", "description": "DPL Fleet serial tracking number", "maxLength": 50 },
        "registrationNumber": { "type": "string", "description": "Official vehicle license plate number", "maxLength": 50 },
        "category": { "type": "string", "description": "Vehicle carrier regulatory classification", "maxLength": 80 },
        "type": { "type": "string", "description": "Trailer type such as Flatbed or Container carrier", "maxLength": 80 },
        "driverName": { "type": "string", "description": "Assigned driver's full name", "maxLength": 120 },
        "driverCnic": { "type": "string", "description": "Assigned driver's national identity card number", "maxLength": 30 },
        "driverContact": { "type": "string", "description": "Assigned driver's mobile phone number", "maxLength": 40 },
        "transporterName": { "type": "string", "description": "Transporter company name", "maxLength": 150 },
        "status": { "type": "string", "description": "Current availability status", "maxLength": 50 },
        "createdAt": { "type": "string", "description": "Creation timestamp", "maxLength": 50 },
        "createdBy": { "type": "string", "description": "UID of creator", "maxLength": 128 }
      },
      "required": ["dplSerial", "registrationNumber", "category", "driverName", "status"]
    },
    "AppUser": {
      "title": "AppUser",
      "description": "Registered system user account profile with role and authorization",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase authentication UID", "maxLength": 128 },
        "name": { "type": "string", "description": "User's full name", "maxLength": 120 },
        "email": { "type": "string", "description": "User's email address", "maxLength": 150 },
        "role": { "type": "string", "description": "System role such as ADMIN, CLIENT, etc.", "maxLength": 50 },
        "contact": { "type": "string", "description": "User phone or WhatsApp contact number", "maxLength": 40 },
        "status": { "type": "string", "description": "Account status ACTIVE or INACTIVE", "enum": ["ACTIVE", "INACTIVE"] },
        "clientName": { "type": "string", "description": "Associated company if role is CLIENT", "maxLength": 150 },
        "createdAt": { "type": "string", "description": "Account creation timestamp", "maxLength": 50 }
      },
      "required": ["uid", "name", "email", "role", "status"]
    },
    "AppNotification": {
      "title": "AppNotification",
      "description": "Action center task notification or alert",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Notification ID" },
        "title": { "type": "string", "description": "Notification summary title", "maxLength": 150 },
        "description": { "type": "string", "description": "Short explanation", "maxLength": 300 },
        "details": { "type": "string", "description": "Expanded information", "maxLength": 1000 },
        "timestamp": { "type": "string", "description": "Notification display time or date", "maxLength": 60 },
        "type": { "type": "string", "description": "Category ACTION, INFO, or ALERT", "enum": ["ACTION", "INFO", "ALERT"] },
        "status": { "type": "string", "description": "PENDING or RESOLVED", "enum": ["PENDING", "RESOLVED"] },
        "priority": { "type": "string", "description": "HIGH, MEDIUM, or LOW", "enum": ["HIGH", "MEDIUM", "LOW"] },
        "actionLabel": { "type": "string", "description": "Action button text", "maxLength": 60 }
      },
      "required": ["title", "description", "type", "status"]
    },
    "Setting": {
      "title": "Setting",
      "description": "System wide configuration and company profile",
      "type": "object",
      "properties": {
        "companyName": { "type": "string", "description": "Company legal trade name", "maxLength": 150 },
        "customLogo": { "type": "string", "description": "Custom logo data or URL", "maxLength": 50000 },
        "updatedAt": { "type": "string", "description": "Last update timestamp", "maxLength": 50 },
        "updatedBy": { "type": "string", "description": "UID of admin who updated", "maxLength": 128 }
      }
    },
    "Client": {
      "title": "Client",
      "description": "Registered client entity for case registration and ledger accounts",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique client ID" },
        "name": { "type": "string", "description": "Legal trading or company name of the client", "maxLength": 150 },
        "contact": { "type": "string", "description": "Primary phone or WhatsApp contact", "maxLength": 50 },
        "email": { "type": "string", "description": "Billing or official email address", "maxLength": 150 },
        "openingBalance": { "type": "number", "description": "Initial ledger opening balance in PKR" },
        "createdAt": { "type": "string", "description": "Registration date timestamp", "maxLength": 50 }
      },
      "required": ["name"]
    },
    "Vendor": {
      "title": "Vendor",
      "description": "Registered vendor profile for office supplies, port terminals, and services",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique vendor identifier" },
        "name": { "type": "string", "description": "Vendor business name", "maxLength": 150 },
        "serviceType": { "type": "string", "description": "Service category or trade type", "maxLength": 100 },
        "contactPerson": { "type": "string", "description": "Key point of contact name", "maxLength": 100 },
        "contactNumber": { "type": "string", "description": "Contact telephone or mobile", "maxLength": 50 },
        "city": { "type": "string", "description": "Operating city or port terminal", "maxLength": 80 },
        "status": { "type": "string", "description": "ACTIVE or INACTIVE status", "maxLength": 20 }
      },
      "required": ["name"]
    },
    "RecurringFinanceTemplate": {
      "title": "RecurringFinanceTemplate",
      "description": "Template for periodic recurring financial obligations and overheads",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Template identifier" },
        "title": { "type": "string", "description": "Obligation title", "maxLength": 150 },
        "amount": { "type": "number", "description": "Expected amount in PKR" },
        "category": { "type": "string", "description": "Financial category head", "maxLength": 100 },
        "frequency": { "type": "string", "description": "Frequency e.g. MONTHLY", "maxLength": 50 },
        "active": { "type": "boolean", "description": "Whether template is actively generating" }
      },
      "required": ["title", "amount"]
    },
    "StaffLedgerEntry": {
      "title": "StaffLedgerEntry",
      "description": "Staff imprest, cash advance, or port operations ledger record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Ledger entry identifier" },
        "staffId": { "type": "string", "description": "Unique staff member identifier", "maxLength": 100 },
        "date": { "type": "string", "description": "Date of transaction", "maxLength": 50 },
        "amount": { "type": "number", "description": "Transaction amount in PKR" },
        "type": { "type": "string", "description": "CREDIT or DEBIT", "maxLength": 20 },
        "description": { "type": "string", "description": "Purpose or receipt description", "maxLength": 300 }
      },
      "required": ["staffId", "date", "amount"]
    },
    "StaffPrivateLedgerEntry": {
      "title": "StaffPrivateLedgerEntry",
      "description": "Staff individual port ledger transaction isolating port clearance funds",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Private ledger entry ID" },
        "staffUserId": { "type": "string", "description": "Staff login identifier", "maxLength": 100 },
        "date": { "type": "string", "description": "Transaction date", "maxLength": 50 },
        "amount": { "type": "number", "description": "Amount in PKR" },
        "type": { "type": "string", "description": "INCOME or EXPENSE", "maxLength": 20 },
        "description": { "type": "string", "description": "Description of port activity", "maxLength": 300 }
      },
      "required": ["staffUserId", "date", "amount"]
    },
    "CompanyDocument": {
      "title": "CompanyDocument",
      "description": "Archived official company document, license, or certificate",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique document identifier" },
        "title": { "type": "string", "description": "Document title", "maxLength": 200 },
        "category": { "type": "string", "description": "Document classification category", "maxLength": 100 },
        "fileUrl": { "type": "string", "description": "URL or stored document link", "maxLength": 2000 },
        "uploadedAt": { "type": "string", "description": "Upload timestamp", "maxLength": 50 }
      },
      "required": ["title", "category"]
    },
    "CompanyDocumentCategory": {
      "title": "CompanyDocumentCategory",
      "description": "Taxonomy category for classifying official company documents",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Category display name", "maxLength": 100 },
        "createdAt": { "type": "string", "description": "Category creation date", "maxLength": 50 }
      },
      "required": ["name"]
    },
    "DestinationStaff": {
      "title": "DestinationStaff",
      "description": "Port and border clearance field personnel directory",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique staff identifier" },
        "name": { "type": "string", "description": "Staff member's full name", "maxLength": 120 },
        "station": { "type": "string", "description": "Assigned customs station or port", "maxLength": 100 },
        "contact": { "type": "string", "description": "Mobile contact number", "maxLength": 50 },
        "role": { "type": "string", "description": "Field responsibility designation", "maxLength": 80 }
      },
      "required": ["name", "station"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Audit trail log for tracking critical system and portal events",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Log record identifier" },
        "action": { "type": "string", "description": "Action performed", "maxLength": 200 },
        "performedBy": { "type": "string", "description": "User who took the action", "maxLength": 150 },
        "timestamp": { "type": "string", "description": "Event timestamp", "maxLength": 50 },
        "details": { "type": "string", "description": "Detailed log contextual data", "maxLength": 1000 }
      },
      "required": ["action", "timestamp"]
    },
    "Branding": {
      "title": "Branding",
      "description": "Company visual branding, theme colors, and logos",
      "type": "object",
      "properties": {
        "customLogo": { "type": "string", "description": "Base64 or image URL", "maxLength": 50000 },
        "companyName": { "type": "string", "description": "Displayed company title", "maxLength": 150 },
        "updatedAt": { "type": "string", "description": "Timestamp of update", "maxLength": 50 }
      }
    }
  },
  "firestore": {
    "/clients/{clientId}": {
      "schema": "Client",
      "description": "Master directory of registered clients for cases and ledgers"
    },
    "/cases/{caseId}": {
      "schema": "Case",
      "description": "Collection of logistics shipment cases"
    },
    "/finances/{financeId}": {
      "schema": "FinanceEntry",
      "description": "Financial ledger transactions, invoices, and expenses"
    },
    "/finance/{financeId}": {
      "schema": "FinanceEntry",
      "description": "Legacy financial entries mirror path"
    },
    "/vehicles/{vehicleId}": {
      "schema": "Vehicle",
      "description": "Fleet and contractor transport vehicles"
    },
    "/users/{userId}": {
      "schema": "AppUser",
      "description": "User profiles and RBAC role assignments"
    },
    "/notifications/{notificationId}": {
      "schema": "AppNotification",
      "description": "System tasks and notification alerts"
    },
    "/settings/{settingId}": {
      "schema": "Setting",
      "description": "Global company settings and profile"
    },
    "/vendors/{vendorId}": {
      "schema": "Vendor",
      "description": "Directory of approved terminal, maintenance, and facility vendors"
    },
    "/recurring_templates/{templateId}": {
      "schema": "RecurringFinanceTemplate",
      "description": "Recurring monthly expense and invoice templates"
    },
    "/staff_ledgers/{ledgerId}": {
      "schema": "StaffLedgerEntry",
      "description": "Staff advance and port operations ledgers"
    },
    "/staff_loading_bills/{billId}": {
      "schema": "FinanceEntry",
      "description": "Loading port bills created by port staff for terminal charges"
    },
    "/staff_private_ledgers/{ledgerId}": {
      "schema": "StaffPrivateLedgerEntry",
      "description": "Port staff isolated clearance expense ledgers"
    },
    "/available_vehicles/{vehicleId}": {
      "schema": "Vehicle",
      "description": "Fleet vehicles currently available and ready for cargo loading"
    },
    "/transporter_requests/{requestId}": {
      "schema": "AppNotification",
      "description": "Vehicle registration, renewal, or trip update requests from transporters"
    },
    "/destination_staff/{staffId}": {
      "schema": "DestinationStaff",
      "description": "Border and port staff directory"
    },
    "/activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "System security and operational activity audit logs"
    },
    "/branding/{brandingId}": {
      "schema": "Branding",
      "description": "Company branding and customized logo assets"
    },
    "/company_documents/{docId}": {
      "schema": "CompanyDocument",
      "description": "Official company archives, licenses, and permits"
    },
    "/company_document_categories/{catId}": {
      "schema": "CompanyDocumentCategory",
      "description": "Categories for organizing official company documentation"
    }
  }
}
