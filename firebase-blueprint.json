        "fcmTokens": { "type": "array", "items": { "type": "string" }, "description": "Active Firebase Cloud Messaging device push tokens for mobile and desktop" },
        "pushNotificationsEnabled": { "type": "boolean", "description": "Whether push notifications are enabled by the user" },
